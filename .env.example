# Copy to .env.local for local development. Never commit actual credentials.
# Replace the placeholders with your PostgreSQL connection details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Set a private, strong password before public deployment. Do not use demo credentials.
TEACHER_PASSWORD=

# Generate a random secret (at least 32 random bytes); Render's Blueprint generates this automatically.
AUTH_SECRET=

# Optional canonical public HTTPS origin. Leave empty in local development.
# On Render the app automatically uses RENDER_EXTERNAL_URL.
# This must point to the deployed app, not Arena or an e2b preview URL.
APP_PUBLIC_URL=
